							},
							"font": "Arial;13;0",
							"left": 40,
							"top": 20,
							"width": 340,
							"height": 80,
							"text": "CLIENTE (chat-cliente) · MVC\nVista → Controlador → Modelo\nModelo → notifica → Vista (Observer).\nEl Modelo manda/recibe Mensajes por la mensajería."
						},
						{
							"_type": "UMLNoteView",
