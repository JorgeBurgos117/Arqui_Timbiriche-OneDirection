							"name": "IFactoryMensajeria",
							"documentation": "La usa el Ensamblador para armar la mensajeria (como IFactoryRed).",
							"operations": [
								{
									"_type": "UMLOperation",
									"_id": "MSGV3ID000000136",
									"_parent": {
										"$ref": "MSGV3ID000000134"
									},
									"name": "crearMensajeriaCliente",
									"parameters": [
