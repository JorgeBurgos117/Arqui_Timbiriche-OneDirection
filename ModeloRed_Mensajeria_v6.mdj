							},
							"font": "Arial;13;0",
							"left": 760,
							"top": 20,
							"width": 410,
							"height": 80,
							"text": "SERVIDOR (chat-servidor) · Blackboard\nServidorChat convierte cada Mensaje en Entrada;\nel control activa las fuentes de conocimiento,\nque leen/escriben el Blackboard."
						},
