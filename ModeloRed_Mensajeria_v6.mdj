								},
								{
									"_type": "UMLNoteView",
									"_id": "MSGV3ID000001357",
									"_parent": {
										"$ref": "AAAAAAGhp0Hr90xmRKc="
									},
									"font": "Arial;13;0",
									"left": 40,
									"top": 625,
									"width": 480,
									"height": 90,
									"text": "FabricaMensajes.crearMensaje():\n  Mensaje m = new Mensaje();\n  m.setRemitente(remitente);  m.setFechaHora(LocalDateTime.now());\n  m.setIpOrigen(miIp);  m.setPuertoOrigen(miPuerto);\n  return m;     // siempre completo, y siempre como IMensajeAdmon"
								},
								{
									"_type": "UMLNoteView",
									"_id": "MSGV3ID000001358",
									"_parent": {
										"$ref": "AAAAAAGhp0Hr90xmRKc="
									},
									"font": "Arial;13;0",
									"left": 40,
									"top": 735,
									"width": 660,
									"height": 100,
									"text": "Mensajeria (el casteo):\ncrearMensaje():  IMensajeAdmon m = fabrica.crearMensaje();\n                 return (IMensajeApp) m;     // al cliente solo le llega la parte de aplicacion\ncliente:         m.setDestinatario(\"Luis\");  m.setContenido(json);  mensajeria.enviar(m);\nenviar(IMensajeApp app):  IMensajeAdmon m = (IMensajeAdmon) app;   // se castea de nuevo\n                 dispatcher.enviar(m);      // direccion fisica + a la cola"
								},
								{
									"_type": "UMLNoteView",
									"_id": "MSGV3ID000001359",
									"_parent": {
										"$ref": "AAAAAAGhp0Hr90xmRKc="
									},
									"font": "Arial;13;0",
									"left": 40,
									"top": 855,
									"width": 600,
									"height": 70,
									"text": "SOLO HAY DOS TIPOS DE MENSAJE = LAS DOS INTERFACES (no hay enum)\nCliente (fuera de mensajeria): solo ve IMensajeApp -> destinatario y contenido.\nDentro de mensajeria (Mensajeria, DispatcherMensajes, Sender, PingAlive,\nReceptorMensajes, ProcesadorMensajes, manejadores, Serializador): usan IMensajeAdmon."
								},
								{
									"_type": "UMLNoteView",
									"_id": "MSGV3ID000001360",
									"_parent": {
										"$ref": "AAAAAAGhp0Hr90xmRKc="
									},
									"font": "Arial;13;0",
									"left": 1680,
									"top": 340,
									"width": 1060,
									"height": 68,
									"text": "FactoryMensajeria es el UNICO que hace new: FabricaMensajes, Serializador, Directorio, colas, DispatcherMensajes, Sender,\nPingAlive (solo cliente), VerificadorPingAlive y TablaTiempos (solo servidor), ReceptorMensajes, ProcesadorMensajes y manejadores; a la red le pide crearDispatcher() y crearReceptor(miPuerto, receptor).\nCliente: directorio con \"servidor\", manejadorAdmon = ManejadorAdministracion. Servidor: manejadorAdmon = ManejadorAdmonServidor."
								},
								{
									"_type": "UMLNoteView",
									"_id": "MSGV3ID000001361",
									"_parent": {
										"$ref": "AAAAAAGhp0Hr90xmRKc="
									},
									"font": "Arial;13;0",
									"left": 820,
									"top": 1110,
									"width": 920,
									"height": 85,
									"text": "ENVIAR\n1) cliente: IMensajeApp m = mensajeria.crearMensaje();  m.setDestinatario(\"Luis\");  m.setContenido(json)\n2) mensajeria.enviar(m): IMensajeAdmon a = (IMensajeAdmon) m;  dispatcher.enviar(a)\n3) DispatcherMensajes: Nodo n = directorio.buscar(\"Luis\");  a.setIpDestino(n.ip); a.setPuertoDestino(n.puerto);  colaSalida.put(a)\n4) hilo Sender: a = colaSalida.take();  json = serializador.serializar(a);  red.enviar(json, a.getIpDestino(), a.getPuertoDestino())"
								},
								{
									"_type": "UMLNoteView",
									"_id": "MSGV3ID000001362",
									"_parent": {
										"$ref": "AAAAAAGhp0Hr90xmRKc="
									},
									"font": "Arial;13;0",
									"left": 820,
									"top": 1210,
									"width": 920,
									"height": 115,
									"text": "RECIBIR\n1) la red llama ReceptorMensajes.recibir(json)  (callback IReceptorExterno)\n2) IMensajeAdmon a = serializador.deserializar(json);  colaEntrada.put(a)\n3) hilo ProcesadorMensajes: a = colaEntrada.take()\n   de aplicacion -> ManejadorAplicacion -> receptor.recibir((IMensajeApp) a)     de administracion -> manejadorAdmon\nUNA sola colaEntrada para todo (tambien los ping). El receptor solo deserializa y encola; el procesador solo revisa y reparte\n(responsabilidades granulares: si hace falta velocidad se pueden poner varios hilos ProcesadorMensajes sobre la misma cola)."
								},
								{
									"_type": "UMLNoteView",
									"_id": "MSGV3ID000001363",
									"_parent": {
										"$ref": "AAAAAAGhp0Hr90xmRKc="
									},
									"font": "Arial;13;0",
									"left": 820,
									"top": 1340,
									"width": 920,
									"height": 100,
									"text": "BUZON\n0) el Ensamblador arranca red + mensajeria: el buzon todavia NO esta activo\n1) mensajeria.registrar(\"Ana\"): fabrica.setRemitente(\"Ana\");  a = fabrica.crearMensaje() para \"servidor\" (registro) -> dispatcher\n2) servidor: ManejadorAdmonServidor -> directorio.registrar(\"Ana\", new Nodo(ipOrigen, puertoOrigen)) -> responde confirmacion\n3) cliente: ManejadorAdministracion -> pingAlive.iniciar() y receptor.estadoBuzon(true)   (el ping arranca HASTA que confirman)\n   darseDeBaja(): igual, con baja y su confirmacion -> pingAlive.detener()"
								},
								{
									"_type": "UMLNoteView",
									"_id": "MSGV3ID000001364",
									"_parent": {
										"$ref": "AAAAAAGhp0Hr90xmRKc="
									},
									"font": "Arial;13;0",
									"left": 1780,
									"top": 1420,
									"width": 1000,
									"height": 100,
									"text": "PING ALIVE  (es un mensaje administrativo mas; el servidor NUNCA manda ping)\nCLIENTE: se activa cuando el servidor confirma el registro. Cada intervaloMs: a = fabrica.crearMensaje(); a.setDestinatario(\"servidor\"); colaSalida.put(a)\nSERVIDOR: llega a la misma colaEntrada -> ManejadorAdmonServidor -> tabla.actualizar(remitente)  (hora nueva)\nhilo VerificadorPingAlive: tabla.vencidos(tiempoVida) -> por cada buzon vencido: tabla.eliminar(x); directorio.eliminar(x);\n   y a cada nombre de directorio.nombres() le manda un mensaje de administracion \"borra a x de tu lista\"\nCLIENTES: ManejadorAdministracion -> directorio.eliminar(x)"
								}
							]
						},
