<?xml version="1.0" encoding="UTF-8"?>
<!--
  PROYECTO 2: Aplicacion cliente de prueba del componente de red + ensamblador
  (equipo OneDirection).
    chat.ChatRed             -> la aplicacion: solo usa las interfaces de red-api
    ensamblador.Ensamblador  -> arma la aplicacion completa (main)
  Requisito: antes, hacer Clean and Build en 1-ComponenteRed.
  Clean and Build aqui genera target/chat-red.jar (incluye el componente de red):
      java -jar target/chat-red.jar 5001 localhost 5002 Ana
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>chat-red</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>ChatRed</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.mainClass>ensamblador.Ensamblador</exec.mainClass>
        <red.version>1.0-SNAPSHOT</red.version>
    </properties>

    <dependencies>
        <!-- La aplicacion solo usa interfaces (red-api) -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>red-api</artifactId>
            <version>${red.version}</version>
        </dependency>
        <!-- La implementacion (red) solo la conoce el ensamblador -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>red</artifactId>
            <version>${red.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>mensajeria-api</artifactId>
            <version>${red.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>mensajeria</artifactId>
            <version>${red.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>chat-red</finalName>
        <plugins>
            <!-- Genera un jar ejecutable con todo incluido -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ensamblador.Ensamblador</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
