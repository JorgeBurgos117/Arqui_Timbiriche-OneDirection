<?xml version="1.0" encoding="UTF-8"?>
<!--
  PROYECTO 1: Componente de red (equipo OneDirection).
    red-api -> contrato: IDispatcher, IReceptorExterno, IFactoryRed (proyecto separado)
    red     -> implementacion: DispatcherFactory, Dispatcher, Receptor, ClienteTCP,
               ServidorTCP, LengthFramer, Paquete
  En NetBeans: Clean and Build (instala red-api y red en el repositorio local de Maven,
  para que el proyecto 2-ChatRed los pueda usar).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>componente-red</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ComponenteRed</name>

    <modules>
        <module>red-api</module>
        <module>red</module>
        <module>mensajeria-api</module>
        <module>mensajeria</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.example</groupId>
                <artifactId>red-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
